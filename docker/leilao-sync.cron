# Agendador diario do sync no GitHub.
# 11:00 UTC = 08:00 America/Sao_Paulo. Dispara o workflow daily-sync.yml.
# Roda apenas de segunda a sexta (1-5): a Caixa nao atualiza os CSV nos
# fins de semana, causando falha no workflow Sabado/Domingo.
# O download dos CSVs roda no runner do GitHub (VPS bloqueada pela Caixa);
# este cron apenas aciona a API do GitHub, sem tocar na Caixa.
SHELL=/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin

0 11 * * 1-5 root cd /app && uv run python -m pipeline.trigger_github_sync --verbose >> /var/log/leilao-sync.log 2>&1
